# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# URL pública usada en enlaces de seguimiento y correos
ALTAVERA_SITE_URL=https://www.altaveraenlinea.com
NEXT_PUBLIC_SITE_URL=https://www.altaveraenlinea.com

# Correos transaccionales (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
ALTAVERA_EMAIL_FROM=Altavera <pedidos@altaveraenlinea.com>

# Push admin
VAPID_PUBLIC_KEY=
ALTAVERA_PUSH_INTERNAL_SECRET=

# Buscador de lugares. Puede apuntar a otra instancia compatible de Nominatim.
ALTAVERA_GEOCODING_URL=https://nominatim.openstreetmap.org/search

# Referencia competitiva Walmart (opcionales; estos son los valores por defecto)
WALMART_REFERENCE_LABEL="Walmart Alajuela — Río Segundo (Las Cañas)"
WALMART_REFERENCE_COUNTRY="CRI"
WALMART_REFERENCE_LATITUDE="10.00263"
WALMART_REFERENCE_LONGITUDE="-84.20602"

WALMART_SALES_CHANNEL="1"
# Cambios mayores a este porcentaje se bloquean hasta revisión manual.
WALMART_MAX_PRICE_CHANGE_PERCENT="40"
# Una corrida de precios exige una actualización Walmart exitosa dentro de esta ventana.
WALMART_MAX_FRESHNESS_HOURS="24"
# Si Walmart devuelve menos productos que esto, se considera una respuesta incompleta.
WALMART_MIN_PRODUCTS="50"
# También se exige al menos este porcentaje del catálogo Walmart ya conocido.
WALMART_MIN_CATALOG_RATIO="0.5"
